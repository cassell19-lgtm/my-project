---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { idToPath } from "../nav";

export async function getStaticPaths() {
  const entries = await getCollection("pages");
  return entries.map((entry) => ({
    // idToPath は前後にスラッシュを付けるので、params 用に外す
    params: { slug: idToPath(entry.id).replace(/^\/|\/$/g, "") || undefined },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 冒頭の本文を description に使う (見出し・表・記号は落とす)
const description = entry.body
  ?.replace(/^---[\s\S]*?---/, "")
  .replace(/<[^>]+>/g, "")
  .replace(/^[#|\-*].*$/gm, "")
  .replace(/\s+/g, " ")
  .trim()
  .slice(0, 120);
---

<Layout title={entry.data.title} description={description}>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</Layout>
